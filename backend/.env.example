# Database: must use the asyncpg driver prefix (postgresql+asyncpg://)
# Local: DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dermascan
# Docker: DATABASE_URL=postgresql+asyncpg://dermascan:dermascan@db:5432/dermascan
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dermascan
APP_NAME=DermaScan API
# Set DEBUG=false in production
DEBUG=true
ALLOWED_ORIGINS=["*"]
